# OpenAI-Compatible API Configuration
# This project uses a generic API client that works with any OpenAI-compatible endpoint
# (e.g., Ollama, vLLM, LocalAI, Groq, etc.)

# Base URL of the API endpoint
# For Ollama: http://localhost:11434
# For vLLM: http://localhost:8000
# For Groq: https://api.groq.com/openai
API_BASE=http://localhost:11434

# Model name to use
# For Ollama: llama3, mistral, codellama, etc.
# For vLLM: depends on your deployed model
# For Groq: llama3-70b-8192, mixtral-8x7b-32768, etc.
MODEL=llama3

# API Key (often not required for local deployments)
# For Ollama: can be left as "ollama" or any value
# For cloud providers: set your actual API key
API_KEY=ollama

# Context window size (maximum tokens the model can process in a single request)
# Common values: 2048, 4096, 8192, 32768, 64000
CONTEXT_WINDOW_SIZE=64000

# Max tokens for response generation (default limit for API calls)
# Should be less than CONTEXT_WINDOW_SIZE to leave room for the prompt
# Common values: 512, 1024, 2048, 4096
MAX_TOKENS=4096
